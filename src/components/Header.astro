---
import HeaderLink from './HeaderLink.astro'
---

<header>
  <nav class="shadow-lg">
    <div class="flex items-center w-fit p-0.75 pl-2.5 pr-2">
      <HeaderLink href="/" title="主页" class="icon-[tabler--tent]" />
      <HeaderLink
        href="/words"
        title="文章列表"
        class="icon-[tabler--notebook]"
      />
      <HeaderLink
        href="/authors"
        title="作者列表"
        class="icon-[tabler--snowman]"
      />
      <HeaderLink
        href="/declarations"
        title="法律声明"
        class="icon-[tabler--scale]"
      />
      <HeaderLink href="/write" title="投稿" class="icon-[tabler--mail]" />
      <HeaderLink href="/rss" title="RSS订阅" class="icon-[tabler--rss]" />
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0em 0 1.6em;
  }
</style>

<script>
  function isPC() {
    return window.matchMedia('(pointer:fine)').matches
  }

  const nav = document.querySelector('nav') as HTMLElement
  if (isPC()) {
    nav.addEventListener('mousemove', (e) => {
      const rect = nav.getBoundingClientRect()
      let x = e.clientX - rect.left - 600
      x = Math.min(Math.max(x * 0.2, -50), 0)
      nav.style.backgroundPosition = `${x}px 0px`
    })
    nav.addEventListener('mouseleave', () => {
      nav.style.backgroundPosition = '0px 0px'
    })
  }
</script>
