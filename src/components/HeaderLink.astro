---
export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, title, class: className, ...props } = Astro.props
---

<a
  href={href}
  title={title}
  class="pushable text-white opacity-70 transition duration-[160ms] hover:opacity-100"
  class:list={[className]}
  {...props}
>
  <slot />
</a>
