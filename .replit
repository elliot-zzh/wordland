run = "pnpm dev"
# Astro 7 needs Node >=22.23.4. The nodejs-24 module supplies Node and pnpm;
# vue-node-20 would put Node 20 back on PATH.
modules = ["nodejs-24", "web"]

[nix]
channel = "stable-24_11"

[deployment]
run = ["sh", "-c", "pnpm dev"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 80

[agent]
expertMode = true
